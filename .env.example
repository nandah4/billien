# Copy the database URI from Neon Console. Keep it server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Auth URL for this database branch. Do not use NEXT_PUBLIC_ for secrets.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth

# Generate with: openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
