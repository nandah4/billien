# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable here is server-only: none may use the NEXT_PUBLIC_ prefix.

# Neon connection string. Copy it from the Neon Console. Keep it server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Auth URL for this database branch.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth

# Generate with: openssl rand -base64 48
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Dictionary provider. The word and ?translations=true are appended to this base,
# so it must end at the entries collection.
DICTIONARY_BASE_URL=https://freedictionaryapi.com/api/v1/entries/en
# Optional. Milliseconds per request. Defaults to 8000.
# DICTIONARY_TIMEOUT_MS=8000

# InferHub ([OI]-compatible). Used only as a translation fallback when the
# dictionary has no translation for the user's preferred language.
INFERHUB_API_KEY=sk-airo-REPLACE_ME
INFERHUB_BASE_URL=https://api.inferhub.dev
INFERHUB_MODEL=deepseek-v4.1-flash
# Optional. Milliseconds per attempt, before the single retry. Defaults to 15000.
# INFERHUB_TIMEOUT_MS=15000
